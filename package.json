{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "cpx-official",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "node --watch --env-file-if-exists=.env server/index.js",
        "dev:web": "vite",
        "start": "node --env-file-if-exists=.env server/index.js",
        "db:setup": "node --env-file-if-exists=.env server/setup-database.js",
        "check": "node --check server/index.js && node --check server/database.js && node --check src/main.js && vite build"
    },
    "dependencies": {
        "@neondatabase/serverless": "^1.0.1"
    },
    "devDependencies": {
        "vite": "^7.0.4"
    },
    "engines": {
        "node": ">=20.19.0"
    }
}
